{
  "name": "gantry",
  "version": "0.1.0",
  "private": true,
  "description": "A warm, focused desktop code editor",
  "author": "valerisn",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && node scripts/collect-licenses.cjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts electron.vite.config.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "package": "npm run build && electron-builder --win dir portable",
    "postinstall": "node scripts/check-native.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "monaco-editor": "0.57.0",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright": "1.63.0",
    "prettier": "3.8.5",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "dev.valerisn.gantry",
    "npmRebuild": false,
    "productName": "Gantry",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/logo.png"
    },
    "artifactName": "Gantry-${version}-${arch}.${ext}"
  },
  "overrides": {
    "dompurify": "3.4.16"
  }
}
